# Copia este archivo como  .env  y rellena tus valores.
# NUNCA subas el .env a GitHub (ya está en .gitignore).
# En GitHub, estos mismos valores van en Settings → Secrets and variables → Actions.

# Token que te da @BotFather al crear el bot.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Número del chat al que se enviarán los recordatorios.
# Lo obtienes ejecutando:  python obtener_chat_id.py
TELEGRAM_CHAT_ID=123456789

# Opcional: solo si usarás recordatorios de tipo "ia".
# Obtén tu llave en https://console.anthropic.com
ANTHROPIC_API_KEY=
